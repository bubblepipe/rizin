NAME=mcs96 sjmp
FILE=malloc://4096
CMDS=<<EOF
e asm.arch=mcs96
wx 2010
ao 1~type,jump
EOF
EXPECT=<<EOF
type: jmp
jump: 0x00000012
EOF
RUN

